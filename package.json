{
  "name": "obsidian-two-euro-collection",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write \"main.js\" \"scripts/**/*.js\" \"*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"main.js\" \"scripts/**/*.js\" \"*.json\" \".github/workflows/*.yml\"",
    "validate": "node --check main.js && npm run format:check",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:version": "node scripts/release.js",
    "outdated": "npm outdated",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "security": "npm audit && npm outdated"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
