{
  "name": "obsidian-two-euro-collection",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "npm run build && node --test --test-force-exit \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" esbuild.config.mjs \"*.json\" \"Languages/*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" esbuild.config.mjs \"*.json\" \"Languages/*.json\" \".github/workflows/*.yml\"",
    "validate": "npm run lint && npm run test && npm run format:check",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:version": "node scripts/release.js",
    "outdated": "npm outdated",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "security": "npm audit && npm outdated",
    "beta": "node scripts/beta.js",
    "starter-pack": "node scripts/build-starter-pack.js",
    "starter-pack:publish": "node scripts/publish-starter-pack.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "yaml": "^2.9.1"
  }
}
